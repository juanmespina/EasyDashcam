    <!-- Settings -->
    <string name="no_settings">No hay ajustes disponibles</string>
    <string name="about_version">v%1$s · solo local, sin cuentas</string>
    <string name="setdesc_0000">Calidad de vídeo. Mayor resolución = placas y señales más nítidas, archivos más grandes.</string>
    <string name="setdesc_0003">Duración de cada archivo de bucle. Cuando la tarjeta se llena, se sobrescribe el clip más antiguo.</string>
    <string name="setdesc_0004">Rango dinámico amplio (WDR) — equilibra el cielo brillante con las sombras, p. ej. al salir de un túnel.</string>
    <string name="setdesc_0005">Incluir audio del micrófono en las grabaciones.</string>
    <string name="setdesc_0100">Tamaño de la foto en megapíxeles.</string>
    <string name="setdesc_0101">Brillo manual. Súbelo en escenas oscuras, bájalo si el cielo sale quemado.</string>
    <string name="setdesc_0108">Temperatura de color según la iluminación; Automático vale para la mayoría de los trayectos.</string>
    <string name="setdesc_0200">Frecuencia de red eléctrica de tu región (50 Hz Europa, 60 Hz América). Un valor incorrecto hace que farolas y salpicaderos parpadeen en el vídeo.</string>
    <string name="setdesc_0201">Cuánto tiempo permanece encendida la pantalla LCD de la cámara antes de apagarse.</string>
    <string name="setdesc_0205">Orden de la fecha impresa en las grabaciones.</string>
    <string name="setdesc_0209">Versión del firmware de la cámara.</string>

