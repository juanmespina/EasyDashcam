<?xml version="1.0" encoding="utf-8"?>
<!-- Local-only app: nothing here is worth backing up (media lives in
     MediaStore, everything else is re-fetched from the camera). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
